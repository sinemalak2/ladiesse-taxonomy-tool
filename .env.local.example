# Postgres (Neon) — use the *pooled* connection string from the Neon dashboard
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Shopify Admin API — from your app's Dev Dashboard "Credentials" panel.
# Exchanged for a short-lived access token via the client credentials grant
# (see lib/shopifyAuth.js) — no static token to paste anymore.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when calling GET /api/sync. Generate any random string.
CRON_SECRET=

# Login gate (replaces Vercel password protection) — see middleware.js.
# AUTH_SECRET signs the session cookie; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SITE_PASSWORD=
SITE_EMAIL_DOMAIN=ladiesse.com

# Stage 2 (user affinity vectors) — GA4 -> BigQuery export. Set up in GA4:
# Admin -> Product Links -> BigQuery Links (daily export), then create a
# service account with BigQuery Data Viewer + Job User roles on that project
# and download its JSON key.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GA4_BQ_PROJECT_ID=
GA4_BQ_DATASET=analytics_XXXXXXXXX

# On Vercel (no persistent filesystem for GOOGLE_APPLICATION_CREDENTIALS to
# point at), set this instead to the service account key's raw JSON
# contents, e.g.: node -e "console.log(require('fs').readFileSync('./service-account.json','utf8'))"
# and paste the single-line output as this var's value.
GA4_BQ_CREDENTIALS_JSON=

# Shared secret ladiesse-ai-search sends as `Authorization: Bearer
# $AFFINITY_API_SECRET` when calling GET /api/users/:user_key/affinity —
# lets that call bypass the login gate (see middleware.js). Generate any
# random string, same way as AUTH_SECRET above.
AFFINITY_API_SECRET=
